MAC_RELEASE_APP_NAME=bars
MAC_RELEASE_REPO=steipete/CodexBar
MAC_RELEASE_BUNDLE_ID=com.sirrayi.bars
MAC_RELEASE_VERSION_FILE=version.env
MAC_RELEASE_APPCAST=appcast.xml
MAC_RELEASE_SOURCE_FILES='Scripts/release_artifacts.sh'
MAC_RELEASE_SUPUBLIC_ED_KEY=AGCY8w5vHirVfGGDGc8Szc5iuOqupZSh9pMj/Qs67XI=

MAC_RELEASE_APP_ZIP='$(bars_app_zip_name "$MARKETING_VERSION" "${ARCHES:-arm64 x86_64}")'
MAC_RELEASE_DSYM_ZIP='$(bars_dsym_zip_name "$MARKETING_VERSION" "${ARCHES:-arm64 x86_64}")'
MAC_RELEASE_ARTIFACT_PREFIX='bars-macos-[A-Za-z0-9_+-]+-'
MAC_RELEASE_FEED_URL='https://raw.githubusercontent.com/steipete/CodexBar/main/appcast.xml'
MAC_RELEASE_DOWNLOAD_URL_PREFIX='https://github.com/steipete/CodexBar/releases/download/v${MARKETING_VERSION}/'

MAC_RELEASE_GENERATE_APPCAST_ARGS='--maximum-deltas 0'
MAC_RELEASE_EXTRA_ASSET_WAIT_SECONDS=3600
MAC_RELEASE_EXTRA_ASSET_WAIT_INTERVAL=30
MAC_RELEASE_EXTRA_ASSET_PATTERNS='^BarsCLI-v${MARKETING_VERSION}-macos-arm64\.tar\.gz$
^BarsCLI-v${MARKETING_VERSION}-macos-arm64\.tar\.gz\.sha256$
^BarsCLI-v${MARKETING_VERSION}-macos-x86_64\.tar\.gz$
^BarsCLI-v${MARKETING_VERSION}-macos-x86_64\.tar\.gz\.sha256$
^BarsCLI-v${MARKETING_VERSION}-linux-aarch64\.tar\.gz$
^BarsCLI-v${MARKETING_VERSION}-linux-aarch64\.tar\.gz\.sha256$
^BarsCLI-v${MARKETING_VERSION}-linux-x86_64\.tar\.gz$
^BarsCLI-v${MARKETING_VERSION}-linux-x86_64\.tar\.gz\.sha256$
^BarsCLI-v${MARKETING_VERSION}-linux-musl-aarch64\.tar\.gz$
^BarsCLI-v${MARKETING_VERSION}-linux-musl-aarch64\.tar\.gz\.sha256$
^BarsCLI-v${MARKETING_VERSION}-linux-musl-x86_64\.tar\.gz$
^BarsCLI-v${MARKETING_VERSION}-linux-musl-x86_64\.tar\.gz\.sha256$
^BarsDesktop-v${MARKETING_VERSION}-linux-x86_64\.tar\.gz$
^BarsDesktop-v${MARKETING_VERSION}-linux-x86_64\.tar\.gz\.sha256$
^BarsDesktop-v${MARKETING_VERSION}-linux-aarch64\.tar\.gz$
^BarsDesktop-v${MARKETING_VERSION}-linux-aarch64\.tar\.gz\.sha256$'
